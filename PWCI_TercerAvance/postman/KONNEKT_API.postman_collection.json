{
  "info": {
    "name": "KONNEKT API",
    "description": "API de cursos del segundo avance y gestión de categorías del tercer avance. Configura las credenciales solo para uso local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/PWCI_TercerAvance"
    },
    {
      "key": "instructor_email",
      "value": ""
    },
    {
      "key": "instructor_password",
      "value": ""
    },
    {
      "key": "curso_id",
      "value": "1"
    },
    {
      "key": "admin_email",
      "value": ""
    },
    {
      "key": "admin_password",
      "value": ""
    },
    {
      "key": "csrf_token",
      "value": ""
    },
    {
      "key": "categoria_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar sesión como instructor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{instructor_email}}"
                },
                {
                  "key": "password",
                  "value": "{{instructor_password}}"
                }
              ]
            },
            "url": "{{base_url}}/public/index.php?r=login"
          }
        },
        {
          "name": "Iniciar sesión como administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{admin_email}}"
                },
                {
                  "key": "password",
                  "value": "{{admin_password}}"
                }
              ]
            },
            "url": "{{base_url}}/public/index.php?r=login"
          }
        }
      ]
    },
    {
      "name": "Cursos",
      "item": [
        {
          "name": "Consultar cursos - 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/index.php/cursos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar detalle - 200 o 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/index.php/cursos/{{curso_id}}"
          }
        },
        {
          "name": "Curso inexistente - 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/index.php/cursos/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar curso - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"API REST con PHP\",\n  \"descripcion\": \"Curso práctico\",\n  \"categoria_id\": 2,\n  \"costo\": 0,\n  \"imagen\": \"\"\n}"
            },
            "url": "{{base_url}}/api/index.php/cursos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('curso_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar curso inválido - 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"\",\n  \"descripcion\": \"\",\n  \"categoria_id\": 0,\n  \"costo\": -10\n}"
            },
            "url": "{{base_url}}/api/index.php/cursos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Dar de baja curso - 200",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/index.php/cursos/{{curso_id}}"
          }
        }
      ]
    },
    {
      "name": "Categorías (administrador)",
      "item": [
        {
          "name": "Consultar categorías y obtener token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/index.php/categorias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200 && pm.response.json().csrf_token) {",
                  "  pm.collectionVariables.set('csrf_token', pm.response.json().csrf_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear categoría - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/index.php/categorias",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Categoría de prueba KONNEKT\",\n  \"descripcion\": \"Prueba del administrador.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('categoria_id', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar categoría - 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/index.php/categorias/{{categoria_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Categoría editada KONNEKT\",\n  \"descripcion\": \"Descripción actualizada.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar nombre vacío - 400",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/index.php/categorias/{{categoria_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"   \",\n  \"descripcion\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar categoría - 200",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/index.php/categorias/{{categoria_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
