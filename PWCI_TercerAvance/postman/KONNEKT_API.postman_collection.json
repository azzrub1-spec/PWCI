    {
      "name": "Cursos",
      "item": [
        {
          "name": "Consultar mis cursos y obtener token - 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/index.php/cursos?propios=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('csrf_token', pm.response.json().csrf_token); }"
                ]
              }
            }
          ]
        },
