{
  "info": {
    "name": "KONNEKT API",
    "description": "Peticiones de éxito y error para la API propia de cursos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/PWCI_SegundoAvance"
    },
    {
      "key": "instructor_email",
      "value": "instructor@konnekt.test"
    },
    {
      "key": "instructor_password",
      "value": "Instructor1!"
    },
    {
      "key": "curso_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Iniciar sesión como instructor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{instructor_email}}"
                },
                {
                  "key": "password",
                  "value": "{{instructor_password}}"
                }
              ]
            },
            "url": "{{base_url}}/public/index.php?r=login"
          }
        }
      ]
    },
    {
      "name": "Cursos",
      "item": [
        {
          "name": "Consultar cursos - 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/index.php/cursos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar detalle - 200 o 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/index.php/cursos/{{curso_id}}"
          }
        },
        {
          "name": "Curso inexistente - 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/index.php/cursos/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar curso - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"API REST con PHP\",\n  \"descripcion\": \"Curso práctico\",\n  \"categoria_id\": 2,\n  \"costo\": 0,\n  \"imagen\": \"\"\n}"
            },
            "url": "{{base_url}}/api/index.php/cursos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('curso_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar curso inválido - 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"\",\n  \"descripcion\": \"\",\n  \"categoria_id\": 0,\n  \"costo\": -10\n}"
            },
            "url": "{{base_url}}/api/index.php/cursos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Código 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Dar de baja curso - 200",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/index.php/cursos/{{curso_id}}"
          }
        }
      ]
    }
  ]
}

